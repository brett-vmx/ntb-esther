{
  "mainTitle": "༄༅། །ཨེས་སི་ཐེར་གྱི་མདོ།",
  "introTitle": "ཨེས་སི་ཐེར་གྱི་མདོ་ཞེས་བྱ་བའི་ངོ་སྤྲོད་མདོར་བསྡུས།",
  "sections": [
    {
      "heading": "ཁ་བྱང་དང་ལོ་རྒྱུས་རྒྱབ་ལྗོངས།",
      "paragraphs": [
        "གཞུང་འདིའི་ཁ་བྱང་ནི་མི་སྣ་གཙོ་བོ་ཨེས་སི་ཐེར་ཞེས་པའི་མིང་ནས་ཐོགས་པ་ཡིན། ཨེས་སི་ཐེར་ནི་ཏ་ཟིག་གི་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོ་ཡིས་རང་གི་བཙུན་མོར་བསུས་པའི་ཡ་ཧུ་དཱའི་བུ་མོ་ཡིད་དུ་འོང་པ་ཞིག་ཡིན། གཞུང་འདིའི་འབྱུང་ཡུལ་ཏ་ཟིག་གི་རྒྱལ་ས་སོའུ་སཱན་གྲོང་ཁྱེར་ཡིན་པ་དང་། སྐབས་དེར་རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོ་ཡིས་རྒྱལ་ཁམས་དེར་སྲིད་སྐྱོང་བཞིན་ཡོད། དེ་ནི་སྤྱི་ལོ་སྔོན་གྱི་486-465ལོའི་བར་ཡིན།"
      ]
    },
    {
      "heading": "ཡི་གེར་འགོད་མཁན་དང་འགོད་དུས།",
      "paragraphs": [
        "བདག་ཅག་གིས་གཞུང་འདི་ཡི་གེར་འགོད་མཁན་སུ་ཡིན་མི་ཤེས་མོད། འོན་ཀྱང་ཡི་གེར་འགོད་མཁན་ཡ་ཧུ་དཱ་པ་ཞིག་ཡིན་པ་གསལ་པོ་རེད། ཅིའི་ཕྱིར་ཞེ་ན། གཞུང་འདི་ལ་ཡ་ཧུ་དཱའི་པུ་རིམ་ཞེས་པའི་དུས་ཆེན་ཚུགས་པའི་འབྱུང་ཁུངས་དང་མི་རིགས་རིང་ལུགས་ཀྱི་ཤན་ཞུགས་ཡོད། ཁུངས་མང་པོ་ཞིག་ལ་བརྟེན་ནས་ཡི་གེར་འགོད་མཁན་ཡ་ཧུ་དཱ་པ་དེ་ཏ་ཟིག་གྲོང་ཁྱེར་གྱི་མི་ཡིན་པའི་བདེན་དཔང་རྙེད་ཡོད། གཞུང་འདི་ཡི་གེར་བཀོད་པའི་ལོ་ཚིགས་སྔ་ཤོས་ནི་གཞུང་གི་ནང་དུ་བྱུང་བའི་གནས་ཚུལ་གྱི་རྗེས་ཏག་ཏག་སྟེ། སྤྱི་ལོ་སྔོན་གྱི་460ལོའི་ཡས་མས་ཡིན། ལོ་ཚིགས་འཕྱི་ཤོས་ནི་གྷི་རིག་སི་གོང་མའི་རྒྱལ་ཁྱབ་ཀྱིས་སྤྱི་ལོ་331ལོར་ཏ་ཟིག་རྒྱལ་ཁམས་དབང་དུ་མ་བསྡུས་པའི་སྔོན་ལ་ཡི་གེར་བཀོད་པ་ཞིག་ཡིན།"
      ]
    },
    {
      "heading": "བརྗོད་སྙིང་དང་གསུང་འཕྲིན།",
      "paragraphs": [
        "ཡི་གེར་འགོད་མཁན་གྱི་དམིགས་ཡུལ་གཙོ་བོ་ནི་པུ་རིམ་ཞེས་པའི་ལོ་འཁོར་དུས་ཆེན་བཙུགས་པ་དེ་ཡིག་ཐོག་ལ་ཕབ་པ་དང་། རྒྱལ་པོ་ཨ་ཧཱ་ཝེ་རོ་ཡིས་སྲིད་བསྐྱངས་པའི་སྐབས་སུ། ཁོས་ཡ་ཧུ་དཱ་མི་རིགས་གསོད་རྩིས་བྱས་མོད། དཀོན་མཆོག་གིས་ཁོ་ཚོར་སྲུང་སྐྱོབ་ཆེན་པོ་གནང་བ་དང་། དོན་དག་དེ་མི་རབས་ཕྱི་མ་དག་གིས་མུ་མཐུད་དུ་སེམས་ལ་བཟུང་ནས་མི་བརྗེད་པའི་ཆེད་དུ་ཡི་གེར་བཀོད་པ་ཡིན། གཞུང་འདིའི་ནང་དུ་དཀོན་མཆོག་གི་མཚན་བཀོད་མེད་ནའང་། ཁོང་གིས་རང་ཉིད་ཀྱིས་བདམས་པའི་མི་རྣམས་ལ་གཟིགས་སྐྱོང་གནང་བ་གསལ་པོར་བསྟན་ཡོད། གསོལ་སྟོན་ལ་རོལ་ཞེས་པ་ནི་ཨེས་སི་ཐེར་གྱི་གཞུང་འདིའི་བརྗོད་བྱ་འབུར་དུ་ཐོན་པ་ཞིག་ཡིན།"
      ]
    },
    {
      "heading": "འཆར་ཟིན།",
      "paragraphs": [
        "1. ཨ་ཧཱ་ཝེ་རོའི་གསོལ་སྟོན་གྱི་སྐོར། ༼1:1-2:18༽",
        "2. ཨེས་སི་ཐེར་གྱི་གསོལ་སྟོན་སྐོར། ༼2:19-7:10༽",
        "3. པུ་རིམ་ཞེས་པའི་གསོལ་སྟོན་སྐོར། ༼8:1-10:3༽"
